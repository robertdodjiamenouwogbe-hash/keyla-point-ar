rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estConnecte() {
      return request.auth != null;
    }

    function monRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function monEquipe() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.equipeId;
    }

    function estAdmin() {
      return estConnecte() && monRole() == 'admin';
    }

    function estSuperviseurDe(equipeId) {
      return estConnecte() && monRole() == 'superviseur' && monEquipe() == equipeId;
    }

    // --- Utilisateurs ---
    match /users/{userId} {
      allow read: if estConnecte() && (request.auth.uid == userId || estAdmin() || monRole() == 'superviseur');
      allow create, update: if estAdmin() ||
        (monRole() == 'superviseur' && request.resource.data.role == 'ar' && request.resource.data.equipeId == monEquipe());
      allow delete: if estAdmin();
    }

    // --- Équipes ---
    match /equipes/{equipeId} {
      allow read: if estConnecte();
      allow create, update, delete: if estAdmin();
    }

    // --- Points journaliers ---
    match /points_journaliers/{pointId} {
      allow read: if estAdmin()
        || estSuperviseurDe(resource.data.equipeId)
        || (estConnecte() && resource.data.arId == request.auth.uid);

      // Un AR ne peut créer que son propre point, un seul par jour
      // (contrôle final réalisé par une Cloud Function de validation).
      allow create: if estConnecte() && request.resource.data.arId == request.auth.uid;

      // Seul le superviseur de l'équipe (ou l'admin) peut valider/rejeter.
      allow update: if estAdmin() || estSuperviseurDe(resource.data.equipeId);

      allow delete: if estAdmin();
    }
  }
}
